{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuSQL",
  "version": "2.3.0",
  "identifier": "com.rusql.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run stage-engine && npm run stage-python",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RuSQL",
        "width": 1320,
        "height": 990,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/engine_server.exe": "engine/engine_server.exe",
      "engine/msvcp140.dll": "engine/msvcp140.dll",
      "engine/vcruntime140.dll": "engine/vcruntime140.dll",
      "engine/vcruntime140_1.dll": "engine/vcruntime140_1.dll",
      "pyenv/python/": "python/",
      "../../mcp/mcp_server.py": "mcp/mcp_server.py",
      "../../mcp/requirements.txt": "mcp/requirements.txt"
    },
    "licenseFile": "installer/license.txt",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerHooks": "installer/installer-hooks.nsh"
      }
    }
  }
}
